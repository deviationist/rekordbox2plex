# Rekordbox
REKORDBOX_FOLDER_PATH="/path/to/rekordbox/"
REKORDBOX_MASTERDB_PATH="/path/to/rekordbox/master.db"
REKORDBOX_MASTERDB_PASSWORD="402fd482c38817c35ffa8ffb8c7d93143b749e7d315df7a81732a1ff43608497"
REKORDBOX_COPY_DB_BEFORE_SYNC=true
REKORDBOX_PLAYLISTS_TO_IGNORE="Some Playlist"

# Plex
PLEX_URL="http://localhost:32400"
PLEX_TOKEN=""
PLEX_LIBRARY_NAME="Music"
PLEX_PLAYLIST_FLATTENING_DELIMITER="/"

# Date Added sync (`dates` subcommand) — direct Plex DB write, see README.
# PLEX_DB_PATH is required for `dates`; the rest are optional knobs (defaults shown).
#PLEX_DB_PATH="/path/to/Plug-in Support/Databases/com.plexapp.plugins.library.db"
#PLEX_CONTAINER_NAME="plex"               # checked (docker) to be stopped before any write
#PLEX_SQLITE_MECHANISM="docker"           # docker = bundled Plex SQLite (required for Plex); sqlite3 = scratch copies only
#PLEX_DOCKER_IMAGE="linuxserver/plex"     # image providing the bundled Plex SQLite binary
#PLEX_SQLITE_BIN="/usr/lib/plexmediaserver/Plex SQLite"
#REKORDBOX_TZ="America/New_York"          # only used for naive Rekordbox timestamps
#REKORDBOX_ADDED_AT_FIELD="created_at"    # djmdContent column feeding added_at

# Metadata parity audit (`parity` subcommand, read-only). Reuses PLEX_DB_PATH above.
# Comma-separated substrings; a track whose Rekordbox FolderPath contains any is
# excluded from the check (both sides). E.g. "Memes" matches .../on-hold/Memes/x.mp3:
#REKORDBOX_FOLDER_PATHS_TO_IGNORE="Memes,unsorted"
# --split-artists set-compares artist/albumartist on a direct miss, splitting both
# sides on the collab separators below (ARTIST_COLLAB_*). The ambiguous &/+ tier is
# opt-in via ARTIST_COLLAB_EXTRA_SEPARATORS (or --collab-extra-seps) — without it,
# only comma + feat./ft. split, so "Fred V & Grafix" vs "Fred V, Grafix" stays flagged.

# AIFF title fix (`aiff-titles` subcommand). Repairs AIFF files whose legacy native
# NAME chunk (which Plex reads) shadows the correct ID3 TIT2 (which Rekordbox/OneTagger
# use). Reuses PLEX_DB_PATH above. PLEX_MEDIA_PATH_MAP is REQUIRED here: comma-separated
# container=host path-prefix pairs so the tool can open the audio files on disk (Plex
# stores container paths like /data/music; the host mounts them elsewhere). Longest
# prefix wins.
#PLEX_MEDIA_PATH_MAP="/data/music=/tank/music"
#AIFF_BACKUP_DIR="/path/to/aiff-title-backups"   # default: ./aiff-title-backups

# Artist images (`artist-images` subcommand). Sets Plex ARTIST POSTERS from external
# sources for a local-metadata library (the one sanctioned artwork-via-API exception).
# Each artist's MBID comes from Plex's own agent match (falling back to MusicBrainz),
# then the poster is fetched by name/MBID from the providers below, in order.
# Provider order (default: fanarttv,theaudiodb,deezer,spotify,bandcamp,discogs).
# Curated MBID-keyed portraits first (fanart.tv, TheAudioDB — closest to what Plex's
# agent prefers); then streaming sources (Deezer needs no auth; Spotify needs a free
# app's client id+secret); then Bandcamp (no auth — strong for underground/electronic;
# returns the artist's own image, photo or logo); Discogs last as the broad fallback
# (its community images are often release covers, not portraits).
#PLEX_ARTIST_IMAGE_PROVIDERS="fanarttv,theaudiodb,deezer,spotify,bandcamp,discogs"
# Collab-split tuning (multi-artist names). The full string is tried across every source
# first; only on a miss is it split (comma/feat always). Opt into ambiguous separators
# (&, +) here — a genuine "&"-artist (e.g. Above & Beyond) resolves whole and is never
# split, but "Bendik Baksaas + Fredrik Høyer" becomes a collage. Empty = off.
#ARTIST_COLLAB_EXTRA_SEPARATORS="& + x"
# Both separator tiers are configurable. Word separators (x, vs, feat) require a
# space on BOTH sides (so "Aphex Twin"/"Max" are safe, "A x B" splits); symbol
# separators (, & +) match tight or spaced ("A+B" or "A + B"). Primary (always-on)
# tier defaults to comma + feat/ft/featuring; override whitespace-separated (so ','
# is a token), e.g. ", feat ft featuring":
#ARTIST_COLLAB_PRIMARY_SEPARATORS=", feat ft featuring"
# Stricter MusicBrainz score for split pieces (default 95) and min segment length so tiny
# fragments from a bad split (e.g. "Bz") are skipped (default 2; raise to 3+ to drop 2-char).
#ARTIST_COLLAB_MIN_SCORE="95"
#ARTIST_COLLAB_MIN_SEGMENT_LEN="2"
# Spotify app credentials (client-credentials flow — no user login). Create a free
# app at https://developer.spotify.com/dashboard. Without these, spotify is skipped.
#SPOTIFY_CLIENT_ID="your-spotify-client-id"
#SPOTIFY_CLIENT_SECRET="your-spotify-client-secret"
# Discogs auth — EITHER a personal access token OR a consumer key+secret (token wins).
# Get them at https://www.discogs.com/settings/developers
#DISCOGS_TOKEN="your-personal-access-token"
#DISCOGS_KEY="your-consumer-key"
#DISCOGS_SECRET="your-consumer-secret"
# TheAudioDB defaults to the public test key "2" (heavily rate-limited under load —
# set your own for headroom). fanart.tv needs a (free) personal key or it's skipped.
#THEAUDIODB_API_KEY="2"
#FANARTTV_API_KEY="your-fanarttv-key"
#MUSICBRAINZ_USER_AGENT="rekordbox2plex/0.1 ( https://github.com/you/contact )"

# Orphan handling
DELETE_ORPHANED_PLAYLISTS=true

# Folder mappings
#FOLDER_MAPPINGS_PATH="/path/to/folderMappings.json"

# Misc
#LOGGER_NAME="rekordbox2plex"
