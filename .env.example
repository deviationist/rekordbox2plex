# Rekordbox
REKORDBOX_FOLDER_PATH="/path/to/rekordbox/"
REKORDBOX_MASTERDB_PATH="/path/to/rekordbox/master.db"
REKORDBOX_MASTERDB_PASSWORD="402fd482c38817c35ffa8ffb8c7d93143b749e7d315df7a81732a1ff43608497"
REKORDBOX_COPY_DB_BEFORE_SYNC=true
REKORDBOX_PLAYLISTS_TO_IGNORE="Some Playlist"

# Plex
PLEX_URL="http://localhost:32400"
PLEX_TOKEN=""
PLEX_LIBRARY_NAME="Music"
PLEX_PLAYLIST_FLATTENING_DELIMITER="/"

# Date Added sync (`dates` subcommand) — direct Plex DB write, see README.
# PLEX_DB_PATH is required for `dates`; the rest are optional knobs (defaults shown).
#PLEX_DB_PATH="/path/to/Plug-in Support/Databases/com.plexapp.plugins.library.db"
#PLEX_CONTAINER_NAME="plex"               # checked (docker) to be stopped before any write
#PLEX_SQLITE_MECHANISM="docker"           # docker = bundled Plex SQLite (required for Plex); sqlite3 = scratch copies only
#PLEX_DOCKER_IMAGE="linuxserver/plex"     # image providing the bundled Plex SQLite binary
#PLEX_SQLITE_BIN="/usr/lib/plexmediaserver/Plex SQLite"
#REKORDBOX_TZ="America/New_York"          # only used for naive Rekordbox timestamps
#REKORDBOX_ADDED_AT_FIELD="created_at"    # djmdContent column feeding added_at

# Metadata parity audit (`parity` subcommand, read-only). Reuses PLEX_DB_PATH above.
# Comma-separated substrings; a track whose Rekordbox FolderPath contains any is
# excluded from the check (both sides). E.g. "Memes" matches .../on-hold/Memes/x.mp3:
#REKORDBOX_FOLDER_PATHS_TO_IGNORE="Memes,unsorted"

# Orphan handling
DELETE_ORPHANED_PLAYLISTS=true

# Folder mappings
#FOLDER_MAPPINGS_PATH="/path/to/folderMappings.json"

# Misc
#LOGGER_NAME="rekordbox2plex"
