REKORDBOX_FOLDER_PATH="/path/to/rekordbox/"
REKORDBOX_MASTERDB_PATH="/path/to/rekordbox/master.db"
REKORDBOX_MASTERDB_PASSWORD=""
REKORDBOX_COPY_DB_BEFORE_SYNC=true
REKORDBOX_FOLDER_PATHS_TO_IGNORE="Some Folder"
REKORDBOX_PLAYLISTS_TO_IGNORE="Some Playlist"

PLEX_URL="http://localhost:32400"
PLEX_TOKEN=""
PLEX_LIBRARY_NAME="Music"
PLEX_PLAYLIST_FLATTENING_DELIMITER="/"

# Track mapper behaviour
MAP_TRACK_TITLE=true
MAP_TRACK_ARTIST=true
MAP_TRACK_ALBUM_ARTIST=true
MAP_TRACK_ALBUM=true
MAP_TRACK_ARTWORK=true
OVERWRITE_EXISTING_TRACK_ARTWORK=true
ADD_NEW_TRACKS=true

# Album mapper behaviour
MAP_ALBUM_YEAR=true
MAP_ALBUM_ARTWORKS=true
OVERWRITE_EXISTING_ALBUM_ARTWORK=true

# Oprhaned items behaviour
DELETE_ORPHANED_TRACKS=true
DELETE_ORPHANED_PLAYLISTS=true
DELETE_ORPHANED_ALBUMS=false
